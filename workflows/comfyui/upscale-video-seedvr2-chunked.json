{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None",
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Clip, decoded framesPerBatch frames per pass"
    }
  },
  "2": {
    "class_type": "VHS_BatchManager",
    "inputs": {
      "frames_per_batch": 33
    },
    "_meta": {
      "title": "Meta batch: re-queue every framesPerBatch frames (4n+1: SeedVR2 pads a pass to 4n+1 frames)"
    }
  },
  "3": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": true,
      "decode_tile_size": 768,
      "decode_tile_overlap": 128,
      "tile_debug": "false",
      "offload_device": "cpu",
      "cache_model": true
    },
    "_meta": {
      "title": "SeedVR2 VAE, read by the pack's own loader (its encoder is not a core VAE: core VAEEncodeTiled asks it for handles_tiling / format_encoded and 0.43.1 has none)"
    }
  },
  "4": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "swap_io_components": false,
      "offload_device": "cpu",
      "cache_model": true,
      "attention_mode": "sdpa"
    },
    "_meta": {
      "title": "SeedVR2 3B DiT (fp8), kept in RAM between passes"
    }
  },
  "5": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "dit": [
        "4",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "seed": 42,
      "resolution": 1080,
      "max_resolution": 3840,
      "batch_size": 33,
      "uniform_batch_size": true,
      "color_correction": "lab",
      "temporal_overlap": 0,
      "prepend_frames": 0,
      "input_noise_scale": 0,
      "latent_noise_scale": 0,
      "offload_device": "cpu",
      "enable_debug": false
    },
    "_meta": {
      "title": "Restore this pass: encode, one-step DiT, decode and colour-match, all inside the pack (the shorter edge becomes shortSide px)"
    }
  },
  "6": {
    "class_type": "VHS_VideoInfo",
    "inputs": {
      "video_info": [
        "1",
        3
      ]
    },
    "_meta": {
      "title": "Source frame rate"
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "audio": [
        "1",
        2
      ],
      "frame_rate": [
        "6",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/upscale-video-seedvr2-chunked",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 17,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Encode as the passes come (the last pass writes the file, with the source's sound)"
    }
  }
}
